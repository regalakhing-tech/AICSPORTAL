# Copy these names with a replacement credential to the private server file.
AICS_EXTERNAL_AI_ENABLED=1
AICS_EXTERNAL_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AICS_EXTERNAL_AI_MODEL=openai/gpt-oss-20b
AICS_EXTERNAL_AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
AICS_EXTERNAL_AI_API_KEY=
AICS_EXTERNAL_AI_TIMEOUT_SECONDS=12
AICS_EXTERNAL_AI_IMAGE_ENABLED=0
AICS_EXTERNAL_AI_STATE_ROOT=C:\xampp\aics_private\external_ai

# Gemini vision document scanner (primary AI reader of uploaded documents).
# Create a key at https://aistudio.google.com/apikey and paste it after the = sign.
AICS_GEMINI_API_KEY=
AICS_GEMINI_IMAGE_ENABLED=1
AICS_GEMINI_MODEL=gemini-3.5-flash-lite
AICS_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
AICS_GEMINI_TIMEOUT_SECONDS=45
VALID_ID_OWNER_MODE=applicant
