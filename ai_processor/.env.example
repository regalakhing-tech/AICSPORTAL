AICS_DB_HOST=localhost
AICS_DB_PORT=3306
AICS_DB_NAME=AICSdb
AICS_DB_USER=root
AICS_DB_PASS=
AICS_PROJECT_ROOT=C:\\xampp\\htdocs\\AICS\\AICS
AICS_UPLOAD_ROOT=C:\\xampp\\htdocs\\AICS\\AICS\\Applicants\\uploads
AICS_POPPLER_PATH=
AICS_PDF_TIMEOUT_SECONDS=60
AICS_OCR_TIMEOUT_SECONDS=45
AICS_TESSERACT_PATH=
AICS_MAX_PDF_PAGES=3
AICS_BLUR_THRESHOLD=80
AICS_AI_STALE_MINUTES=30
# PHP CLI used to run tools/ai-gate-sync.php after each check (submission gate).
AICS_PHP_EXECUTABLE=
AICS_ADCD_ENABLED=0
AICS_ADCD_ENFORCE_REVIEW=0
# Local-only ADCD-Net service. These are deployment paths; set them in the
# server/worker environment and never commit a populated .env file.
AICS_ADCD_SERVICE_URL=http://127.0.0.1:5001
AICS_ADCD_PYTHON_EXECUTABLE=
AICS_ADCD_NET_ROOT=
AICS_ADCD_OUTPUT_ROOT=
AICS_ADCD_CHECKPOINT=
AICS_ADCD_DOCRES_CHECKPOINT=
AICS_ADCD_QT_TABLE=
AICS_ADCD_DEVICE=auto
AICS_ADCD_TIMEOUT_SECONDS=90
AICS_ADCD_SAVE_MASKS=0
# Apache/XAMPP server-only worker launcher settings. These must be available
# to Apache as environment variables, not exposed in browser pages.
AICS_PYTHON_EXECUTABLE=py
AICS_PYTHON_VERSION=-3.13
# Private, non-web-served visualization destination. Grant the Apache worker
# account read/write access; grant the web server no direct public alias.
AICS_AI_REVIEW_ARTIFACT_ROOT=C:\\xampp\\aics_private\\ai_review_artifacts
# HTTP fixture runtime only. Use a separate empty database and a separately
# started local PHP server/Apache test alias; never point this at AICSdb.
AICS_HTTP_TEST_MODE=0
AICS_TEST_DB_HOST=localhost
AICS_TEST_DB_PORT=3306
AICS_TEST_DB_NAME=aics_http_regression
AICS_TEST_DB_USER=root
AICS_TEST_DB_PASSWORD=
